---
import { MACHINE_LANGS } from "../i18n/machine";
import { getTranslationSource } from "../i18n/source";
import { defaultLang, languages, type Lang } from "../i18n/ui";
import {
  getLangFromUrl,
  getLocalizedPath,
  getPathWithoutLang,
  useTranslations,
} from "../i18n/utils";

const currentLang = getLangFromUrl(Astro.url);
const currentPath = getPathWithoutLang(Astro.url);
const t = useTranslations(currentLang);
const { hash } = await getTranslationSource();

const localized = new Intl.DisplayNames([currentLang], { type: "language" });
const english = new Intl.DisplayNames(["en"], { type: "language" });

const capitalize = (value: string, locale: string) =>
  value.charAt(0).toLocaleUpperCase(locale) + value.slice(1);

const normalize = (value: string) =>
  value
    .normalize("NFD")
    .replace(/\p{Diacritic}/gu, "")
    .toLowerCase();

const describe = (code: string) => {
  const native = capitalize(
    new Intl.DisplayNames([code], { type: "language" }).of(code) ?? code,
    code,
  );
  const inPageLang = capitalize(localized.of(code) ?? code, currentLang);
  return {
    code,
    native,
    hint: inPageLang === native ? "" : inPageLang,
    search: normalize(
      [code, native, inPageLang, english.of(code) ?? ""].join(" "),
    ),
  };
};

const originals = (Object.keys(languages) as Lang[]).map((code) => ({
  ...describe(code),
  native: languages[code],
  href: getLocalizedPath(code, currentPath),
}));

const machine = (Object.keys(MACHINE_LANGS) as string[])
  .map(describe)
  .sort((a, b) => a.native.localeCompare(b.native, currentLang));

const machineBase = getLocalizedPath(defaultLang, currentPath);
const currentLabel = languages[currentLang];
---

<div
  class="lang-picker relative"
  data-lang-picker
  data-current={currentLang}
  data-hash={hash}
  data-machine-base={machineBase}
  data-msg-loading={t("translate.loading")}
  data-msg-error={t("translate.error")}
>
  <label for="lang-picker-input" class="sr-only" data-i18n="language.label">
    {t("language.label")}
  </label>
  <div class="relative flex items-center">
    <svg
      class="text-muted pointer-events-none absolute start-0 size-4"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
    >
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"></path>
    </svg>
    <input
      id="lang-picker-input"
      type="text"
      role="combobox"
      aria-autocomplete="list"
      aria-expanded="false"
      aria-controls="lang-picker-list"
      autocomplete="off"
      autocapitalize="off"
      spellcheck="false"
      value={currentLabel}
      placeholder={t("translate.search")}
      data-i18n-placeholder="translate.search"
      data-lang-input
      class="text-muted placeholder:text-muted/60 focus:text-foreground border-border focus-visible:border-foreground w-36 cursor-pointer border-b bg-transparent py-1 ps-6 pe-5 text-sm transition-colors duration-200 outline-none focus:cursor-text"
    />
    <svg
      class="text-muted pointer-events-none absolute end-0 size-3.5"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </div>

  <div
    id="lang-picker-list"
    role="listbox"
    aria-labelledby="lang-picker-input"
    hidden
    data-lang-list
    class="border-border bg-background absolute end-0 top-full z-50 mt-2 max-h-80 w-72 max-w-[calc(100vw-3rem)] overflow-y-auto overscroll-contain rounded-lg border p-1 shadow-lg"
  >
    <div role="group" aria-label={t("language.label")} data-lang-group>
      {
        originals.map((option) => (
          <div
            role="option"
            id={`lang-opt-${option.code}`}
            aria-selected={option.code === currentLang ? "true" : "false"}
            data-lang-option
            data-value={option.code}
            data-label={option.native}
            data-href={option.href}
            data-search={option.search}
            lang={option.code}
            class="lang-option"
          >
            <span>{option.native}</span>
            <span class="text-muted text-xs">{option.hint}</span>
          </div>
        ))
      }
    </div>
    <div role="group" aria-labelledby="lang-picker-machine" data-lang-group>
      <div
        id="lang-picker-machine"
        role="presentation"
        class="lang-group-label text-muted border-border mt-1 border-t px-3 pt-2 pb-1 text-xs tracking-wide uppercase"
      >
        {t("translate.machine")}
      </div>
      {
        machine.map((option) => (
          <div
            role="option"
            id={`lang-opt-${option.code}`}
            aria-selected="false"
            data-lang-option
            data-value={option.code}
            data-label={option.native}
            data-search={option.search}
            lang={option.code}
            class="lang-option"
          >
            <span>{option.native}</span>
            <span class="text-muted text-xs">{option.hint}</span>
          </div>
        ))
      }
    </div>
    <p
      hidden
      data-lang-empty
      class="text-muted px-3 py-2 text-sm"
      data-i18n="translate.noResults"
    >
      {t("translate.noResults")}
    </p>
  </div>

  <p class="sr-only" role="status" aria-live="polite" data-lang-status></p>
</div>

<style>
  .lang-option {
    display: flex;
    cursor: pointer;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    border-radius: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.9375rem;
    color: var(--site-muted);
  }

  .lang-option[data-active] {
    background: var(--site-surface);
    color: var(--site-foreground);
  }

  [data-lang-group][hidden] + [data-lang-group] .lang-group-label {
    margin-top: 0;
    border-top: 0;
  }

  .lang-option[aria-selected="true"] {
    font-weight: 600;
    color: var(--site-foreground);
  }
</style>

<script>
  import { navigate } from "astro:transitions/client";
  import { isMachineLang, type MachineLang } from "../i18n/machine";
  import {
    getRequestedMachineLang,
    translatePage,
  } from "../lib/machineTranslation";

  let pageController: AbortController | undefined;

  const normalize = (value: string) =>
    value
      .normalize("NFD")
      .replace(/\p{Diacritic}/gu, "")
      .toLowerCase()
      .trim();

  function init() {
    pageController?.abort();
    pageController = new AbortController();
    const { signal } = pageController;

    const root = document.querySelector<HTMLElement>("[data-lang-picker]");
    const input = root?.querySelector<HTMLInputElement>("[data-lang-input]");
    const list = root?.querySelector<HTMLElement>("[data-lang-list]");
    const empty = root?.querySelector<HTMLElement>("[data-lang-empty]");
    const status = root?.querySelector<HTMLElement>("[data-lang-status]");
    if (!root || !input || !list || !empty || !status) return;

    const options = Array.from(
      list.querySelectorAll<HTMLElement>("[data-lang-option]"),
    );
    const groups = Array.from(
      list.querySelectorAll<HTMLElement>("[data-lang-group]"),
    );
    const hash = root.dataset.hash ?? "";
    const machineBase = root.dataset.machineBase ?? "/";

    let selected = root.dataset.current ?? "en";
    let active: HTMLElement | undefined;

    const optionFor = (code: string) =>
      options.find((option) => option.dataset.value === code);
    const labelFor = (code: string) => optionFor(code)?.dataset.label ?? code;
    const visibleOptions = () => options.filter((option) => !option.hidden);
    const isOpen = () => !list.hidden;

    const markSelected = () => {
      for (const option of options) {
        option.setAttribute(
          "aria-selected",
          option.dataset.value === selected ? "true" : "false",
        );
      }
    };

    const setActive = (option: HTMLElement | undefined) => {
      active?.removeAttribute("data-active");
      active = option;
      if (option) {
        option.setAttribute("data-active", "");
        input.setAttribute("aria-activedescendant", option.id);
        option.scrollIntoView({ block: "nearest" });
      } else {
        input.removeAttribute("aria-activedescendant");
      }
    };

    const filter = (query: string) => {
      const needle = normalize(query);
      for (const option of options) {
        option.hidden =
          needle !== "" && !(option.dataset.search ?? "").includes(needle);
      }
      for (const group of groups) {
        group.hidden = !group.querySelector("[data-lang-option]:not([hidden])");
      }
      const visible = visibleOptions();
      empty.hidden = visible.length > 0;
      if (!active || active.hidden) setActive(visible[0]);
    };

    const open = () => {
      if (isOpen()) return;
      list.hidden = false;
      input.setAttribute("aria-expanded", "true");
      filter("");
      setActive(optionFor(selected) ?? visibleOptions()[0]);
    };

    const close = () => {
      list.hidden = true;
      input.setAttribute("aria-expanded", "false");
      setActive(undefined);
      input.value = labelFor(selected);
    };

    const move = (step: 1 | -1) => {
      const visible = visibleOptions();
      if (visible.length === 0) return;
      const index = active ? visible.indexOf(active) : -1;
      setActive(visible[(index + step + visible.length) % visible.length]);
    };

    const translate = async (lang: MachineLang) => {
      status.textContent = root.dataset.msgLoading ?? "";
      const result = await translatePage(lang, hash);
      if (result === "aborted") return;

      if (result === "failed") selected = root.dataset.current ?? "en";
      status.textContent =
        result === "failed" ? (root.dataset.msgError ?? "") : "";
      markSelected();
      if (!isOpen()) input.value = labelFor(selected);
    };

    const choose = (option: HTMLElement) => {
      const code = option.dataset.value ?? "";
      close();
      if (code === selected) return;

      if (option.dataset.href) {
        navigate(option.dataset.href);
        return;
      }
      if (!isMachineLang(code)) return;

      const target = `${machineBase}?lang=${encodeURIComponent(code)}`;
      if (location.pathname !== machineBase) {
        navigate(target);
        return;
      }
      history.replaceState(history.state, "", target);
      selected = code;
      input.value = labelFor(code);
      markSelected();
      void translate(code);
    };

    input.addEventListener(
      "focus",
      () => {
        input.select();
      },
      { signal },
    );
    input.addEventListener("click", open, { signal });
    input.addEventListener(
      "input",
      () => {
        open();
        filter(input.value);
      },
      { signal },
    );
    input.addEventListener(
      "keydown",
      (event) => {
        switch (event.key) {
          case "ArrowDown":
            event.preventDefault();
            if (!isOpen()) open();
            else move(1);
            break;
          case "ArrowUp":
            event.preventDefault();
            if (!isOpen()) open();
            else move(-1);
            break;
          case "Enter":
            if (isOpen() && active) {
              event.preventDefault();
              choose(active);
            }
            break;
          case "Escape":
            if (isOpen()) {
              event.preventDefault();
              close();
            }
            break;
          case "Tab":
            if (isOpen()) close();
            break;
        }
      },
      { signal },
    );

    // Keep focus in the input while picking with a pointer.
    list.addEventListener("mousedown", (event) => event.preventDefault(), {
      signal,
    });
    list.addEventListener(
      "click",
      (event) => {
        const option = (event.target as Element).closest<HTMLElement>(
          "[data-lang-option]",
        );
        if (option) choose(option);
      },
      { signal },
    );
    list.addEventListener(
      "mousemove",
      (event) => {
        const option = (event.target as Element).closest<HTMLElement>(
          "[data-lang-option]",
        );
        if (option && option !== active) setActive(option);
      },
      { signal },
    );
    document.addEventListener(
      "pointerdown",
      (event) => {
        if (isOpen() && !root.contains(event.target as Node)) close();
      },
      { signal },
    );

    const requested = getRequestedMachineLang();
    if (requested && location.pathname === machineBase) {
      selected = requested;
      input.value = labelFor(requested);
      markSelected();
      void translate(requested);
    }
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => pageController?.abort());
</script>
