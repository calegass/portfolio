<canvas id="cursor-blob-canvas" aria-hidden="true"></canvas>

<style>
  #cursor-blob-canvas {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
    opacity: 0;
    transition: opacity 0.35s;
  }

  @media (pointer: coarse), (prefers-reduced-motion: reduce) {
    #cursor-blob-canvas {
      display: none;
    }
  }
</style>

<script>
  const TRAIL_LENGTH = 12;
  const MAX_RENDER_LONG = 1920;
  const MAX_RENDER_SHORT = 1080;

  const CLICKABLE = 'a[href], button, [role="combobox"]';
  const ATTRACT_RADIUS = 110;
  const FULL_ARROW_DISTANCE = 24;
  const PULL = 0.35;
  const EASE = 0.18;

  function getRenderSize() {
    const width = window.innerWidth;
    const height = window.innerHeight;
    const longSide = Math.max(width, height);
    const shortSide = Math.min(width, height);
    const scale = Math.min(
      1,
      MAX_RENDER_LONG / longSide,
      MAX_RENDER_SHORT / shortSide,
    );
    return {
      width: Math.round(width * scale),
      height: Math.round(height * scale),
    };
  }

  let canvas = document.getElementById(
    "cursor-blob-canvas",
  ) as HTMLCanvasElement;

  const vertexShader = /* glsl */ `
    attribute vec3 position;
    void main() {
      gl_Position = vec4(position, 1.0);
    }
  `;

  const fragmentShader = /* glsl */ `
    precision mediump float;

    const int TRAIL_LENGTH = 12;
    const float EPS = 1e-4;
    const int ITR = 8;

    const float ARROW_LENGTH = 0.11;
    const float ARROW_HEAD = 0.045;
    const float ARROW_ANGLE = 0.6;
    const float ARROW_RADIUS = 0.011;

    uniform vec2 uResolution;
    uniform vec2 uPointerTrail[TRAIL_LENGTH];
    uniform vec3 uColor;
    uniform float uMorph;
    uniform vec2 uArrowDir;

    vec3 origin = vec3(0.0, 0.0, 1.0);
    vec3 cDir = vec3(0.0, 0.0, -1.0);
    vec3 cSide = vec3(1.0, 0.0, 0.0);
    vec3 cUp = vec3(0.0, 1.0, 0.0);

    float smoothMin(float d1, float d2, float k) {
      float h = exp(-k * d1) + exp(-k * d2);
      return -log(h) / k;
    }

    float segment(vec2 p, vec2 a, vec2 b) {
      vec2 pa = p - a;
      vec2 ba = b - a;
      float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
      return length(pa - ba * h);
    }

    float arrow(vec3 p, vec2 tip, vec2 dir) {
      vec2 normal = vec2(-dir.y, dir.x);
      vec2 tail = tip - dir * ARROW_LENGTH;
      vec2 barbA = tip - (dir * cos(ARROW_ANGLE) + normal * sin(ARROW_ANGLE)) * ARROW_HEAD;
      vec2 barbB = tip - (dir * cos(ARROW_ANGLE) - normal * sin(ARROW_ANGLE)) * ARROW_HEAD;
      float d = min(
        segment(p.xy, tail, tip),
        min(segment(p.xy, tip, barbA), segment(p.xy, tip, barbB))
      );
      return length(vec2(d, p.z)) - ARROW_RADIUS;
    }

    vec2 toScene(vec2 point) {
      return point * uResolution / min(uResolution.x, uResolution.y);
    }

    float map(vec3 p) {
      float baseRadius = 4e-3;
      float radius = baseRadius * float(TRAIL_LENGTH);
      float k = 25.0;
      float blob = 1e5;

      for (int i = 0; i < TRAIL_LENGTH; i++) {
        vec2 pt = toScene(uPointerTrail[i]);
        float sphere = length(p - vec3(pt, 0.0)) - (radius - baseRadius * float(i));
        blob = smoothMin(blob, sphere, k);
      }

      if (uMorph < 0.001) return blob;
      return mix(blob, arrow(p, toScene(uPointerTrail[0]), uArrowDir), uMorph);
    }

    void main() {
      vec2 p = (gl_FragCoord.xy * 2.0 - uResolution) / min(uResolution.x, uResolution.y);
      vec3 ray = origin + cSide * p.x + cUp * p.y;

      float dist = 0.0;
      for (int i = 0; i < ITR; ++i) {
        dist = map(ray);
        ray += cDir * dist;
        if (dist < EPS) break;
      }

      gl_FragColor = dist < EPS
        ? vec4(uColor, 1.0)
        : vec4(0.0, 0.0, 0.0, 0.0);
    }
  `;

  // Populated after lazy init
  let renderer: any = null;
  let scene: any = null;
  let camera: any = null;
  let uniforms: any = null;
  let trail: any[] = [];

  const pointer = { x: -1e4, y: -1e4 };
  const pull = { x: 0, y: 0 };
  const arrowDir = { x: 1, y: 0 };
  let morph = 0;

  let visible = false;
  let rafId = 0;
  let leaveTimeout = 0;
  let settleFrames = 0;
  let initialized = false;
  let cleanup: (() => void) | null = null;

  function nearestClickable() {
    let best: { x: number; y: number; distance: number } | null = null;
    for (const el of document.querySelectorAll<HTMLElement>(CLICKABLE)) {
      const rect = el.getBoundingClientRect();
      if (rect.width === 0 || rect.height === 0) continue;
      const x = Math.min(Math.max(pointer.x, rect.left), rect.right);
      const y = Math.min(Math.max(pointer.y, rect.top), rect.bottom);
      const distance = Math.hypot(x - pointer.x, y - pointer.y);
      if (distance < ATTRACT_RADIUS && (!best || distance < best.distance)) {
        best = { x, y, distance };
      }
    }
    return best;
  }

  // The closer the pointer gets to a clickable, the more the blob leans into
  // it and turns into an arrow. The real cursor is never moved.
  function updateAttraction(): boolean {
    const target = nearestClickable();
    const s = target
      ? Math.min(
          1,
          1 -
            (target.distance - FULL_ARROW_DISTANCE) /
              (ATTRACT_RADIUS - FULL_ARROW_DISTANCE),
        )
      : 0;
    const goal = s * s * (3 - 2 * s);

    morph += (goal - morph) * EASE;
    const pullX = target ? (target.x - pointer.x) * PULL * goal : 0;
    const pullY = target ? (target.y - pointer.y) * PULL * goal : 0;
    pull.x += (pullX - pull.x) * EASE;
    pull.y += (pullY - pull.y) * EASE;

    if (target && target.distance > 1) {
      const dx = (target.x - pointer.x) / target.distance;
      const dy = -(target.y - pointer.y) / target.distance;
      arrowDir.x += (dx - arrowDir.x) * EASE;
      arrowDir.y += (dy - arrowDir.y) * EASE;
      const length = Math.hypot(arrowDir.x, arrowDir.y) || 1;
      arrowDir.x /= length;
      arrowDir.y /= length;
    }

    uniforms.uMorph.value = morph;
    uniforms.uArrowDir.value.set(arrowDir.x, arrowDir.y);

    return (
      Math.abs(goal - morph) > 0.002 ||
      Math.abs(pullX - pull.x) > 0.2 ||
      Math.abs(pullY - pull.y) > 0.2
    );
  }

  function headPosition() {
    return {
      x: ((pointer.x + pull.x) / window.innerWidth) * 2 - 1,
      y: -((pointer.y + pull.y) / window.innerHeight) * 2 + 1,
    };
  }

  function updateTrail() {
    for (let i = TRAIL_LENGTH - 1; i > 0; i--) trail[i].copy(trail[i - 1]);
    const head = headPosition();
    trail[0].set(head.x, head.y);
  }

  function render() {
    const settling = updateAttraction();
    updateTrail();
    renderer.render(scene, camera);
    if (settleFrames > 0 || settling) {
      settleFrames = Math.max(0, settleFrames - 1);
      rafId = requestAnimationFrame(render);
    } else {
      rafId = 0;
    }
  }

  function wake() {
    settleFrames = TRAIL_LENGTH + 4;
    if (visible && !rafId) render();
  }

  function onPointerLeave() {
    visible = false;
    canvas.style.opacity = "0";
    leaveTimeout = window.setTimeout(() => {
      settleFrames = 0;
      cancelAnimationFrame(rafId);
      rafId = 0;
    }, 400);
  }

  function onPointerMove(e: PointerEvent) {
    pointer.x = e.clientX;
    pointer.y = e.clientY;

    if (!visible) {
      clearTimeout(leaveTimeout);
      const head = headPosition();
      trail.forEach((v) => v.set(head.x, head.y));
      canvas.style.opacity = "1";
      visible = true;
    }
    wake();
  }

  async function init() {
    if (initialized) return;
    initialized = true;

    const THREE = await import("three");

    const { width, height } = getRenderSize();
    renderer = new THREE.WebGLRenderer({ canvas, alpha: true });
    renderer.setClearColor(0x000000, 0);
    renderer.setPixelRatio(1);
    renderer.setSize(width, height, false);

    scene = new THREE.Scene();
    camera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    trail = Array.from(
      { length: TRAIL_LENGTH },
      () => new THREE.Vector2(-10, -10),
    );

    function getBlobColor() {
      return document.documentElement.dataset.theme === "dark"
        ? new THREE.Vector3(58 / 255, 55 / 255, 44 / 255)
        : new THREE.Vector3(189 / 255, 185 / 255, 168 / 255);
    }

    uniforms = {
      uResolution: {
        value: new THREE.Vector2(width, height),
      },
      uPointerTrail: { value: trail },
      uColor: { value: getBlobColor() },
      uMorph: { value: 0 },
      uArrowDir: { value: new THREE.Vector2(1, 0) },
    };

    const geometry = new THREE.PlaneGeometry(2, 2);
    const material = new THREE.RawShaderMaterial({
      vertexShader,
      fragmentShader,
      uniforms,
      transparent: true,
    });
    scene.add(new THREE.Mesh(geometry, material));

    function renderCurrentFrame() {
      renderer.render(scene, camera);
    }

    const themeObserver = new MutationObserver(() => {
      uniforms.uColor.value.copy(getBlobColor());
      renderCurrentFrame();
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });

    function onResize() {
      const { width, height } = getRenderSize();
      renderer.setSize(width, height, false);
      uniforms.uResolution.value.set(width, height);
    }
    window.addEventListener("resize", onResize);
    window.addEventListener("scroll", wake, { passive: true });

    cleanup = () => {
      document.removeEventListener("pointermove", onPointerMove);
      document.removeEventListener("pointerleave", onPointerLeave);
      document.removeEventListener("pointercancel", onPointerLeave);
      window.removeEventListener("resize", onResize);
      window.removeEventListener("scroll", wake);
      themeObserver.disconnect();
      geometry.dispose();
      material.dispose();
      renderer.dispose();
    };
  }

  async function onFirstPointerMove(e: PointerEvent) {
    await init();
    onPointerMove(e);
    document.addEventListener("pointermove", onPointerMove);
    document.addEventListener("pointerleave", onPointerLeave);
    document.addEventListener("pointercancel", onPointerLeave);
  }

  function teardown() {
    document.removeEventListener("pointermove", onFirstPointerMove);
    clearTimeout(leaveTimeout);
    cancelAnimationFrame(rafId);
    rafId = 0;
    initialized = false;
    cleanup?.();
    cleanup = null;
    visible = false;
    morph = 0;
    pull.x = pull.y = 0;
  }

  function registerPointerListener() {
    if (
      !window.matchMedia("(pointer: coarse), (prefers-reduced-motion: reduce)")
        .matches
    ) {
      document.addEventListener("pointermove", onFirstPointerMove, {
        once: true,
      });
    }
  }

  registerPointerListener();

  document.addEventListener("astro:before-swap", teardown);
  document.addEventListener("astro:after-swap", () => {
    canvas = document.getElementById("cursor-blob-canvas") as HTMLCanvasElement;
    registerPointerListener();
  });
</script>
