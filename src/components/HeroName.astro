---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<h1
  id="hero-name"
  dir="ltr"
  aria-label={name}
  class="max-w-3xl font-serif font-semibold leading-none text-foreground text-5xl sm:text-7xl md:text-8xl"
>
  <span aria-hidden="true" data-hero-name>{name}</span>
</h1>

<style>
  [data-hero-name] {
    overflow: visible;
    display: block;
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }
</style>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { setupMobileHeroMotion } from "../lib/heroMotion";

  const RADIUS = 150;
  const STRENGTH = 14;
  const MAX_FONT = 96;
  const MIN_FONT = 24;

  type Rect = { cx: number; cy: number };

  gsap.registerPlugin(SplitText);

  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    cleanup = null;

    const foundNameEl = document.querySelector<HTMLElement>("[data-hero-name]");
    const foundHostEl = foundNameEl?.parentElement;
    if (!foundNameEl || !foundHostEl) return;

    const nameEl: HTMLElement = foundNameEl;
    const hostEl: HTMLElement = foundHostEl;

    const split = new SplitText(nameEl, { type: "chars" });
    const chars = split.chars as HTMLElement[];

    function fitToWidth() {
      hostEl.style.fontSize = `${MAX_FONT}px`;
      const available = nameEl.clientWidth;
      const needed = nameEl.scrollWidth;
      if (needed > available && needed > 0) {
        const size = Math.max(MIN_FONT, MAX_FONT * (available / needed));
        hostEl.style.fontSize = `${size}px`;
      }
    }

    fitToWidth();

    let observedWidth = hostEl.clientWidth;
    let observedHeight = hostEl.clientHeight;
    const fitObserver = new ResizeObserver(([entry]) => {
      if (!entry) return;
      const { width, height } = entry.contentRect;
      if (
        Math.abs(width - observedWidth) < 0.5 &&
        Math.abs(height - observedHeight) < 0.5
      ) {
        return;
      }
      observedWidth = width;
      observedHeight = height;
      fitToWidth();
    });
    fitObserver.observe(hostEl);

    function setupMagnetic(): () => void {
      const setX = chars.map((char) =>
        gsap.quickTo(char, "x", { duration: 0.4, ease: "power3.out" }),
      );
      const setY = chars.map((char) =>
        gsap.quickTo(char, "y", { duration: 0.4, ease: "power3.out" }),
      );

      let rects: Rect[] = [];
      function cacheRects() {
        rects = chars.map((char) => {
          const rect = char.getBoundingClientRect();
          return {
            cx: rect.left + rect.width / 2,
            cy: rect.top + rect.height / 2,
          };
        });
      }

      const rectFrame = requestAnimationFrame(cacheRects);
      const rectObserver = new ResizeObserver(cacheRects);
      rectObserver.observe(hostEl);

      let scrollTimeout = 0;
      function onScroll() {
        clearTimeout(scrollTimeout);
        scrollTimeout = window.setTimeout(cacheRects, 1700);
      }
      window.addEventListener("scroll", onScroll, { passive: true });

      function onPointerMove(event: PointerEvent) {
        chars.forEach((_, index) => {
          const { cx, cy } = rects[index] ?? { cx: 0, cy: 0 };
          const dx = event.clientX - cx;
          const dy = event.clientY - cy;
          const distance = Math.hypot(dx, dy);

          if (distance < RADIUS && distance > 0) {
            const force = STRENGTH * (1 - distance / RADIUS);
            const angle = Math.atan2(dy, dx);
            setX[index](-Math.cos(angle) * force);
            setY[index](-Math.sin(angle) * force);
          } else {
            setX[index](0);
            setY[index](0);
          }
        });
      }

      function onPointerLeave() {
        gsap.to(chars, {
          x: 0,
          y: 0,
          duration: 1.2,
          ease: "elastic.out(1, 0.4)",
          stagger: 0.02,
        });
      }

      document.addEventListener("pointermove", onPointerMove);
      document.addEventListener("pointerleave", onPointerLeave);
      document.addEventListener("pointercancel", onPointerLeave);

      return () => {
        clearTimeout(scrollTimeout);
        cancelAnimationFrame(rectFrame);
        rectObserver.disconnect();
        window.removeEventListener("scroll", onScroll);
        document.removeEventListener("pointermove", onPointerMove);
        document.removeEventListener("pointerleave", onPointerLeave);
        document.removeEventListener("pointercancel", onPointerLeave);
        setX.forEach((setter) => {
          setter.tween.kill();
        });
        setY.forEach((setter) => {
          setter.tween.kill();
        });
        gsap.killTweensOf(chars);
      };
    }

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const coarse = window.matchMedia("(pointer: coarse)").matches;

    let interactionCleanup: (() => void) | null = null;
    if (!prefersReduced) {
      interactionCleanup = coarse
        ? setupMobileHeroMotion({ target: nameEl, chars })
        : setupMagnetic();
    }

    cleanup = () => {
      interactionCleanup?.();
      fitObserver.disconnect();
      gsap.killTweensOf(chars);
      split.revert();
    };
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
