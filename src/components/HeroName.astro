---
interface Props {
  name: string;
}
const { name } = Astro.props;
---

<div data-hero-stage class="relative">
  <h1
    id="hero-name"
    aria-label={name}
    class="max-w-3xl font-serif font-semibold leading-none text-foreground text-5xl sm:text-7xl md:text-8xl"
  >
    <span aria-hidden="true" data-hero-name>{name}</span>
  </h1>
  <span aria-hidden="true" data-tilt-hint hidden>Tap to drop the letters</span>
</div>

<style>
  [data-hero-name] {
    overflow: visible;
    display: block;
    white-space: nowrap;
    user-select: none;
    -webkit-user-select: none;
    -webkit-touch-callout: none;
  }

  [data-tilt-hint] {
    display: none;
  }

  @media (pointer: coarse) {
    [data-hero-stage][data-physics-active] {
      display: flex;
      min-height: calc(var(--hero-arena-vh, 24) * 1vh);
      align-items: flex-start;
      touch-action: manipulation;
    }

    [data-hero-stage][data-physics-active] > h1 {
      width: 100%;
    }

    [data-hero-stage][data-physics-active] [data-tilt-hint] {
      display: block;
      position: absolute;
      bottom: 1rem;
      left: 0;
      color: color-mix(in srgb, currentColor 55%, transparent);
      font-size: 0.75rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity 240ms ease;
    }

    [data-tilt-hint][data-visible="true"] {
      opacity: 1;
    }
  }
</style>

<script>
  import gsap from "gsap";
  import { SplitText } from "gsap/SplitText";
  import { ScrollSmoother } from "gsap/ScrollSmoother";
  import { setupHeroPhysics } from "../lib/heroPhysics";

  const RADIUS = 150;
  const STRENGTH = 14;
  const MAX_FONT = 96;
  const MIN_FONT = 24;

  type Rect = { cx: number; cy: number };

  gsap.registerPlugin(SplitText, ScrollSmoother);

  let cleanup: (() => void) | null = null;

  function init() {
    cleanup?.();
    cleanup = null;

    const nameEl = document.querySelector<HTMLElement>("[data-hero-name]");
    const stageEl = document.querySelector<HTMLElement>("[data-hero-stage]");
    const tiltHint = document.querySelector<HTMLElement>("[data-tilt-hint]");
    if (!nameEl || !stageEl) return;

    const stage = stageEl;
    const hostEl = nameEl.parentElement;
    const split = new SplitText(nameEl, { type: "chars" });
    const chars = split.chars as HTMLElement[];

    function fitToWidth() {
      if (!nameEl || !hostEl) return;
      hostEl.style.fontSize = `${MAX_FONT}px`;
      const available = nameEl.clientWidth;
      const needed = nameEl.scrollWidth;
      if (needed > available && needed > 0) {
        const size = Math.max(MIN_FONT, MAX_FONT * (available / needed));
        hostEl.style.fontSize = `${size}px`;
      }
    }

    fitToWidth();

    function setupMagnetic(): () => void {
      const setX = chars.map((ch) =>
        gsap.quickTo(ch, "x", { duration: 0.4, ease: "power3.out" }),
      );
      const setY = chars.map((ch) =>
        gsap.quickTo(ch, "y", { duration: 0.4, ease: "power3.out" }),
      );

      let rects: Rect[] = [];
      function cacheRects() {
        rects = chars.map((ch) => {
          const r = ch.getBoundingClientRect();
          return { cx: r.left + r.width / 2, cy: r.top + r.height / 2 };
        });
      }
      requestAnimationFrame(cacheRects);

      let scrollTimeout = 0;
      function onScroll() {
        clearTimeout(scrollTimeout);
        scrollTimeout = window.setTimeout(cacheRects, 1700);
      }
      window.addEventListener("scroll", onScroll, { passive: true });

      let observedWidth = stage.clientWidth;
      let observedHeight = stage.clientHeight;
      const ro = new ResizeObserver(([entry]) => {
        if (!entry) return;
        const { width, height } = entry.contentRect;
        if (
          Math.abs(width - observedWidth) < 0.5 &&
          Math.abs(height - observedHeight) < 0.5
        ) {
          return;
        }
        observedWidth = width;
        observedHeight = height;
        fitToWidth();
        cacheRects();
      });
      ro.observe(stage);

      const cursor = { x: -500, y: -500 };

      function onPointerMove(e: PointerEvent) {
        cursor.x = e.clientX;
        cursor.y = e.clientY;

        chars.forEach((_, i) => {
          const { cx, cy } = rects[i] ?? { cx: 0, cy: 0 };
          const dx = cursor.x - cx;
          const dy = cursor.y - cy;
          const dist = Math.sqrt(dx * dx + dy * dy);

          if (dist < RADIUS && dist > 0) {
            const force = STRENGTH * (1 - dist / RADIUS);
            const angle = Math.atan2(dy, dx);
            setX[i](-Math.cos(angle) * force);
            setY[i](-Math.sin(angle) * force);
          } else {
            setX[i](0);
            setY[i](0);
          }
        });
      }

      function onPointerLeave() {
        gsap.to(chars, {
          x: 0,
          y: 0,
          duration: 1.2,
          ease: "elastic.out(1, 0.4)",
          stagger: 0.02,
        });
      }

      document.addEventListener("pointermove", onPointerMove);
      document.addEventListener("pointerleave", onPointerLeave);
      document.addEventListener("pointercancel", onPointerLeave);

      return () => {
        document.removeEventListener("pointermove", onPointerMove);
        document.removeEventListener("pointerleave", onPointerLeave);
        document.removeEventListener("pointercancel", onPointerLeave);
        window.removeEventListener("scroll", onScroll);
        ro.disconnect();
      };
    }

    const prefersReduced = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;
    const coarse = window.matchMedia("(pointer: coarse)").matches;

    let interactionCleanup: (() => void) | null = null;
    let disposed = false;
    if (!prefersReduced) {
      if (coarse) {
        void setupHeroPhysics({ stage, chars, tiltHint, fitToWidth }).then(
          (physicsCleanup) => {
            if (disposed) {
              physicsCleanup();
            } else {
              interactionCleanup = physicsCleanup;
            }
          },
        );
      } else {
        interactionCleanup = setupMagnetic();
      }
    }

    cleanup = () => {
      disposed = true;
      interactionCleanup?.();
      split.revert();
    };
  }

  document.addEventListener("astro:page-load", init);
  document.addEventListener("astro:before-swap", () => cleanup?.());
</script>
